"use client";

import Link from "next/link";
import { useEffect, useState } from "react";

type RecoveryLoan = {
  id: string;
  lenderName: string;

  principalCents: number;
  repaymentCents: number;
  amountRepaidCents: number;
  remainingCents: number;

  dueAt: string | null;

  status: string;
};

type RecoveryStep = {
  key: string;
  title: string;
  complete: boolean;
};

type Data = {
  enabled: boolean;

  student?: {
    id: string;
    name: string;
  };

  account?: {
    status: string;

    checkingCents: number;
    savingsCents: number;

    trustScore: number;
  };

  totalOutstandingCents?: number;

  unresolved?: RecoveryLoan[];

  repaidCount?: number;

  recoverySteps?: RecoveryStep[];

  error?: string;
};

function money(cents: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
  }).format(cents / 100);
}

export default function RecoveryCenter({ studentId }: { studentId: string }) {
  const [data, setData] = useState<Data | null>(null);

  const [loading, setLoading] = useState(true);

  async function load() {
    try {
      const response = await fetch(
        `/api/ambassador/economy/student/${studentId}/recovery`,
        {
          cache: "no-store",
        },
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? "Unable to load Recovery Center.");
      }

      setData(result);
    } catch (error) {
      setData({
        enabled: false,

        error:
          error instanceof Error
            ? error.message
            : "Unable to load Recovery Center.",
      });
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    load();

    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [studentId]);

  if (loading) {
    return (
      <div className="rounded-3xl bg-white p-8">Loading Recovery Center...</div>
    );
  }

  if (!data?.enabled) {
    return (
      <div className="rounded-3xl bg-white p-8">
        {data?.error ?? "Recovery Center is not active."}
      </div>
    );
  }

  const inRecovery = data.account?.status === "RECOVERY";

  const unresolved = data.unresolved ?? [];

  return (
    <div className="space-y-7">
      <section
        className={`rounded-[34px] p-8 text-white shadow-xl md:p-10 ${
          inRecovery ? "bg-red-800" : "bg-[#0D1B3D]"
        }`}
      >
        <p className="text-xs font-black uppercase tracking-[0.2em] text-[#F2B705]">
          Future Ready™ Financial Resilience
        </p>

        <h1 className="mt-3 text-4xl font-black md:text-5xl">
          {inRecovery ? "🛠️ Recovery Mode" : "✅ Financial Standing"}
        </h1>

        <p className="mt-4 max-w-3xl text-lg leading-8 text-slate-100">
          {inRecovery
            ? "A bad money decision is not the end of the game. Now you have to solve it."
            : "Your peer obligations are currently under control. Keep your word and protect your Trust Score."}
        </p>

        <div className="mt-7 grid gap-4 sm:grid-cols-4">
          <Stat label="Status" value={data.account?.status ?? "ACTIVE"} />

          <Stat
            label="Checking"
            value={money(data.account?.checkingCents ?? 0)}
          />

          <Stat
            label="Outstanding"
            value={money(data.totalOutstandingCents ?? 0)}
          />

          <Stat
            label="Trust Score"
            value={`${data.account?.trustScore ?? 0}/100`}
          />
        </div>
      </section>

      {inRecovery ? (
        <section className="rounded-[30px] border-2 border-red-200 bg-red-50 p-7">
          <p className="text-xs font-black uppercase tracking-[0.18em] text-red-700">
            Recovery Plan
          </p>

          <h2 className="mt-2 text-3xl font-black text-[#0D1B3D]">
            Get back in the game.
          </h2>

          <div className="mt-6 grid gap-3 md:grid-cols-2">
            {(data.recoverySteps ?? []).map((step) => (
              <article
                key={step.key}
                className={`rounded-2xl border p-5 ${
                  step.complete
                    ? "border-emerald-200 bg-emerald-50"
                    : "border-red-200 bg-white"
                }`}
              >
                <p className="text-lg font-black text-[#0D1B3D]">
                  {step.complete ? "✅" : "⬜"} {step.title}
                </p>
              </article>
            ))}
          </div>

          <p className="mt-5 leading-7 text-slate-700">
            Recovery Mode is not bankruptcy and it is not a permanent label.
            Resolve the obligation, rebuild your Trust Score and keep going.
          </p>
        </section>
      ) : (
        <section className="rounded-[30px] bg-emerald-50 p-7">
          <h2 className="text-3xl font-black text-emerald-900">
            💪 You are financially current.
          </h2>

          <p className="mt-2 leading-7 text-emerald-800">
            The goal is not to avoid every mistake. The goal is to deal with
            money problems before they become bigger ones.
          </p>
        </section>
      )}

      {unresolved.length ? (
        <section className="rounded-[30px] border border-slate-200 bg-white p-7 shadow-sm">
          <p className="text-xs font-black uppercase tracking-[0.18em] text-[#725500]">
            Outstanding Obligations
          </p>

          <h2 className="mt-2 text-3xl font-black text-[#0D1B3D]">
            Money you still owe.
          </h2>

          <div className="mt-6 space-y-4">
            {unresolved.map((loan) => (
              <article
                key={loan.id}
                className="rounded-2xl border border-slate-200 p-5"
              >
                <div className="flex flex-wrap items-start justify-between gap-4">
                  <div>
                    <p className="text-xl font-black text-[#0D1B3D]">
                      {loan.lenderName}
                    </p>

                    <p className="mt-1 text-sm font-bold text-slate-500">
                      {loan.status}
                      {loan.dueAt
                        ? ` · Due ${new Date(loan.dueAt).toLocaleDateString()}`
                        : ""}
                    </p>
                  </div>

                  <div className="text-right">
                    <p className="text-xs font-black uppercase tracking-wider text-slate-400">
                      Remaining
                    </p>

                    <p className="mt-1 text-2xl font-black text-red-700">
                      {money(loan.remainingCents)}
                    </p>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <Link
            href={`/ambassador/student-portal/${studentId}/life-account/money-circle`}
            className="mt-6 inline-flex rounded-xl bg-red-700 px-6 py-3 font-black text-white"
          >
            🤝 GO REPAY MY LOANS
          </Link>
        </section>
      ) : null}

      <section className="rounded-[30px] bg-[#FFF8D9] p-7">
        <p className="text-xs font-black uppercase tracking-[0.18em] text-[#725500]">
          Street Smart Money Rule
        </p>

        <h2 className="mt-2 text-3xl font-black text-[#0D1B3D]">
          Your word has financial value.
        </h2>

        <p className="mt-3 max-w-4xl text-lg leading-8 text-slate-700">
          When someone lends you money, they are trusting both your finances and
          your character. Paying it back on time protects both.
        </p>
      </section>

      <div className="flex flex-wrap gap-3">
        <Link
          href={`/ambassador/student-portal/${studentId}/life-account`}
          className="rounded-xl bg-[#0D1B3D] px-5 py-3 font-black text-white"
        >
          ← Life Account
        </Link>

        <Link
          href={`/ambassador/student-portal/${studentId}/life-account/money-circle`}
          className="rounded-xl bg-violet-700 px-5 py-3 font-black text-white"
        >
          🤝 Money Circle™
        </Link>

        <Link
          href={`/ambassador/student-portal/${studentId}/life-account/friday`}
          className="rounded-xl bg-[#F2B705] px-5 py-3 font-black text-[#0D1B3D]"
        >
          Future Ready Friday™
        </Link>
      </div>
    </div>
  );
}

function Stat({ label, value }: { label: string; value: string }) {
  return (
    <div className="rounded-2xl bg-white/10 p-5">
      <p className="text-xs font-black uppercase tracking-wider text-slate-200">
        {label}
      </p>

      <p className="mt-2 text-2xl font-black">{value}</p>
    </div>
  );
}
