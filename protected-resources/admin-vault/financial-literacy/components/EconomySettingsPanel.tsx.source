"use client";

import { useEffect, useState } from "react";

type EconomySettings = {
  enabled: boolean;
  studentPortalEnabled: boolean;
  autoAddFridayCheck: boolean;
  lifeDropsEnabled: boolean;
  automatedEarningsEnabled: boolean;
  automatedFeesEnabled: boolean;

  fridayCheckEnabled: boolean;

  peerGivingEnabled: boolean;
  peerLendingEnabled: boolean;
  communityFundsEnabled: boolean;

  leaderboardEnabled: boolean;
  publicMilestonesEnabled: boolean;

  randomLifeDropsPerWeek: number;
};

type Cohort = {
  id: string;
  code: string;
  name: string;
  school?: {
    name: string;
  } | null;
};

type ToggleKey =
  | "enabled"
  | "studentPortalEnabled"
  | "autoAddFridayCheck"
  | "lifeDropsEnabled"
  | "automatedEarningsEnabled"
  | "automatedFeesEnabled"
  | "fridayCheckEnabled"
  | "peerGivingEnabled"
  | "peerLendingEnabled"
  | "communityFundsEnabled"
  | "leaderboardEnabled"
  | "publicMilestonesEnabled";

const CONTROLS: Array<{
  key: ToggleKey;
  title: string;
  description: string;
}> = [
  {
    key: "enabled",
    title: "Life Economy",
    description:
      "Master switch for this cohort. Turning it off pauses the experience without deleting student history.",
  },

  {
    key: "studentPortalEnabled",
    title: "Student Life Accounts",
    description:
      "Show checking, savings, goals, transactions and money activities to students.",
  },

  {
    key: "automatedEarningsEnabled",
    title: "Automatic Earnings",
    description:
      "Allow verified Future Ready activity to create simulated earnings.",
  },

  {
    key: "automatedFeesEnabled",
    title: "Automatic Fees",
    description:
      "Allow configured late, overdraft and missed-account-check consequences.",
  },

  {
    key: "fridayCheckEnabled",
    title: "Future Ready Friday™",
    description:
      "Students review accounts, bills, savings, goals and financial decisions each Friday.",
  },

  {
    key: "autoAddFridayCheck",
    title: "Add Friday Check to Curriculum",
    description:
      "Automatically insert the money check into Friday's daily teaching plan.",
  },

  {
    key: "lifeDropsEnabled",
    title: "Real Life Drops",
    description:
      "Use surprise scenarios such as gas, lunch, concert tickets, subscriptions, side hustles and repairs.",
  },

  {
    key: "peerGivingEnabled",
    title: "Peer Giving",
    description: "Students can give simulated money to classmates.",
  },

  {
    key: "peerLendingEnabled",
    title: "Peer Borrowing + Lending",
    description:
      "Students can practice loans, repayment, negotiation and trust.",
  },

  {
    key: "communityFundsEnabled",
    title: "Community Fund",
    description:
      "Allow cohort fundraising, donations and matching-gift simulations.",
  },

  {
    key: "leaderboardEnabled",
    title: "Cohort Leaderboard",
    description:
      "Show positive categories such as saving, giving, goal progress, earning and financial comeback.",
  },

  {
    key: "publicMilestonesEnabled",
    title: "CHA-CHING Milestones",
    description: "Celebrate positive financial milestones across the cohort.",
  },
];

export default function EconomySettingsPanel({
  cohortCode,
}: {
  cohortCode: string;
}) {
  const [settings, setSettings] = useState<EconomySettings | null>(null);

  const [cohort, setCohort] = useState<Cohort | null>(null);

  const [loading, setLoading] = useState(true);

  const [saving, setSaving] = useState(false);

  const [message, setMessage] = useState<string | null>(null);

  useEffect(() => {
    loadSettings();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [cohortCode]);

  async function loadSettings() {
    setLoading(true);
    setMessage(null);

    try {
      const response = await fetch(
        `/api/ambassador/economy/settings?cohortCode=${encodeURIComponent(
          cohortCode,
        )}`,
        {
          cache: "no-store",
        },
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? "Unable to load settings.");
      }

      setSettings(result.settings);

      setCohort(result.cohort);
    } catch (error) {
      setMessage(
        error instanceof Error ? error.message : "Unable to load settings.",
      );
    } finally {
      setLoading(false);
    }
  }

  async function updateToggle(key: ToggleKey, value: boolean) {
    if (!settings) return;

    const previous = settings;

    const next = {
      ...settings,
      [key]: value,
    };

    setSettings(next);
    setSaving(true);
    setMessage(null);

    try {
      const response = await fetch("/api/ambassador/economy/settings", {
        method: "PATCH",

        headers: {
          "Content-Type": "application/json",
        },

        body: JSON.stringify({
          cohortCode,
          [key]: value,
        }),
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error ?? "Unable to save setting.");
      }

      setSettings(result.settings);

      setMessage("Life Economy settings saved.");
    } catch (error) {
      setSettings(previous);

      setMessage(
        error instanceof Error ? error.message : "Unable to save setting.",
      );
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return (
      <div className="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
        Loading Life Economy settings...
      </div>
    );
  }

  if (!settings) {
    return (
      <div className="rounded-3xl border border-red-200 bg-red-50 p-8 font-bold text-red-700">
        {message ?? "Life Economy settings unavailable."}
      </div>
    );
  }

  return (
    <section className="space-y-6">
      <div className="overflow-hidden rounded-[30px] border border-slate-200 bg-white shadow-sm">
        <div className="bg-[#0D1B3D] p-7 text-white">
          <p className="text-xs font-black uppercase tracking-[0.18em] text-[#F2B705]">
            Future Ready™ Life Economy
          </p>

          <div className="mt-3 flex flex-wrap items-center justify-between gap-4">
            <div>
              <h2 className="text-3xl font-black">Cohort Economy Controls</h2>

              <p className="mt-2 text-sm leading-6 text-slate-300">
                {cohort?.name ?? cohortCode}
                {cohort?.school?.name ? ` · ${cohort.school.name}` : ""}
              </p>
            </div>

            <div
              className={`rounded-full px-5 py-2 text-sm font-black ${
                settings.enabled
                  ? "bg-emerald-400 text-emerald-950"
                  : "bg-slate-600 text-white"
              }`}
            >
              {settings.enabled ? "ACTIVE" : "PAUSED"}
            </div>
          </div>
        </div>

        <div className="p-7">
          <p className="max-w-4xl text-sm leading-7 text-slate-600">
            The Life Economy is optional curriculum infrastructure. Pausing it
            never removes student accounts, balances, transactions, goals,
            loans, donations or prior learning history.
          </p>

          {saving ? (
            <p className="mt-3 text-sm font-bold text-[#725500]">Saving...</p>
          ) : null}

          {message ? (
            <p className="mt-3 text-sm font-bold text-slate-600">{message}</p>
          ) : null}
        </div>
      </div>

      <div className="grid gap-4 lg:grid-cols-2">
        {CONTROLS.map((control) => {
          const active = settings[control.key];

          const disabled = control.key !== "enabled" && !settings.enabled;

          return (
            <article
              key={control.key}
              className={`rounded-3xl border p-6 shadow-sm ${
                disabled
                  ? "border-slate-200 bg-slate-50 opacity-60"
                  : active
                    ? "border-emerald-200 bg-emerald-50"
                    : "border-slate-200 bg-white"
              }`}
            >
              <div className="flex items-start justify-between gap-5">
                <div>
                  <h3 className="text-lg font-black text-[#0D1B3D]">
                    {control.title}
                  </h3>

                  <p className="mt-2 text-sm leading-6 text-slate-600">
                    {control.description}
                  </p>
                </div>

                <button
                  type="button"
                  disabled={disabled || saving}
                  onClick={() => updateToggle(control.key, !active)}
                  className={`min-w-[76px] rounded-full px-4 py-2 text-xs font-black ${
                    active
                      ? "bg-[#0D1B3D] text-white"
                      : "bg-slate-200 text-slate-700"
                  }`}
                >
                  {active ? "ON" : "OFF"}
                </button>
              </div>
            </article>
          );
        })}
      </div>

      <div className="rounded-3xl border border-[#F2B705]/40 bg-[#FFF9DF] p-6">
        <p className="text-xs font-black uppercase tracking-[0.16em] text-[#725500]">
          Current Game Defaults
        </p>

        <div className="mt-4 grid gap-3 text-sm font-bold text-[#0D1B3D] sm:grid-cols-2 lg:grid-cols-4">
          <div>🏦 Opening account: $100</div>

          <div>💵 First paycheck: $500</div>

          <div>
            🎲 Life Drops:
            {settings.randomLifeDropsPerWeek}
            /week
          </div>

          <div>💰 Friday Money Check</div>
        </div>
      </div>
    </section>
  );
}
