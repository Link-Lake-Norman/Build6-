export type LifeHappensEvent = {
  key: string;
  emoji: string;
  category: string;
  title: string;
  story: string;
  amountCents: number;
  lesson: string;
  choices: Array<{
    key: "CHECKING" | "EMERGENCY" | "SAVINGS" | "BORROW" | "DELAY";
    label: string;
    description: string;
  }>;
};

