          build skills, and launch your future.
        </p>

        <h2>
          {school.name}
        </h2>

        <p>
          {cohort.name}
        </p>

        <p>
          Program Week: {cohort.currentWeek} of 16
        </p>

      </section>


      <section className="journey-grid">

        <article className="journey-card">
          <h2>
            Readiness Score
          </h2>
          <h3>
            {dashboard.readiness}%
          </h3>
        </article>


        <article className="journey-card">
          <h2>
            Skills Developed
          </h2>
          <h3>
            {dashboard.skills}
          </h3>
        </article>


        <article className="journey-card">
          <h2>
            Career Matches
          </h2>
          <h3>
            {dashboard.matches}
          </h3>
        </article>


        <article className="journey-card">
          <h2>
            Opportunities
          </h2>
          <h3>
            {dashboard.opportunities}
          </h3>
        </article>

      </section>


      <section>

        <h2>
          Current Experience
        </h2>

        <p>
          Launch Ready™: Professional Skills & Internship Readiness
        </p>

        <p>
