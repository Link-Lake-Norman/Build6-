import { cohorts } from "@/content/cohorts";
import { organizations } from "@/content/organizations";

export default function StudentDashboardPage() {

  const cohort = cohorts[0];
  const school = organizations[0];

  const dashboard = {
    readiness: 84,
    skills: 4,
    matches: 3,
    opportunities: 5,
  };

  return (
    <main>

      <section className="hero">

        <h1>
          Future Ready™ Student Dashboard
