:root {
  --navy: #0b3b60;
  --navy-dark: #062a45;
  --navy-deep: #041f35;
  --teal: #00a6a6;
  --aqua: #66c2c6;
  --gold: #f4b942;
  --gold-dark: #d99b24;
  --light: #f7fafc;
  --cream: #fffdf7;
  --gray: #5f6b78;
  --dark: #1f2937;
  --white: #ffffff;
  --border: #e5eaf0;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--white);
  color: var(--dark);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  min-height: 84px;
  display: flex;
  align-items: center;
  gap: 36px;
  padding: 0 6%;
  background: rgba(255,255,255,.97);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(12px);
}

.brand {
  display: flex;
  align-items: center;
  line-height: 1;
  margin-right: auto;
}

.brand-build {
  color: var(--navy);
  font-size: 30px;
  font-weight: 900;
  letter-spacing: -2px;
}

.brand-six {
  color: var(--gold);
  font-size: 42px;
  font-weight: 900;
  margin-left: 3px;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 30px;
  color: var(--navy);
  font-size: 14px;
  font-weight: 700;
}

.main-nav a:hover {
  color: var(--teal);
}

.header-button {
  background: var(--navy);
  color: white;
  padding: 14px 20px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 800;
}

.hero {
  min-height: 680px;
  background:
    radial-gradient(circle at 72% 30%, rgba(0,166,166,.18), transparent 24%),
    radial-gradient(circle at 82% 75%, rgba(244,185,66,.12), transparent 26%),
    linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 62%, var(--navy-deep) 100%);
  color: white;
  padding: 90px 8%;
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  align-items: center;
  gap: 60px;
  position: relative;
  overflow: hidden;
}

.hero-copy,
.hero-art {
  position: relative;
  z-index: 2;
}

.eyebrow,
.section-label {
  font-size: 12px;
  letter-spacing: 3px;
  font-weight: 900;
  color: var(--teal);
  margin: 0 0 18px;
}

.section-label.light {
  color: var(--aqua);
}

.hero-brand {
  display: flex;
  align-items: center;
  line-height: .8;
  margin-bottom: 28px;
}

.hero-brand > span {
  font-size: clamp(62px,7vw,112px);
  font-weight: 950;
  letter-spacing: -7px;
}

.hero-brand > strong {
  font-size: clamp(86px,9vw,148px);
  color: var(--gold);
  font-weight: 950;
  margin-left: 8px;
}

.hero h1 {
  color: var(--gold);
  font-size: clamp(34px,4vw,60px);
  line-height: 1;
  margin: 0 0 28px;
  letter-spacing: -2px;
}

.hero h2 {
  max-width: 700px;
  font-size: clamp(23px,2.4vw,38px);
  line-height: 1.18;
  margin: 0 0 22px;
}

.hero-description {
  max-width: 700px;
  color: #dce7ee;
  font-size: 18px;
  line-height: 1.75;
  margin-bottom: 32px;
}

.hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 50px;
  padding: 0 24px;
  border-radius: 5px;
  font-weight: 900;
  font-size: 13px;
}

.button-gold {
  background: var(--gold);
  color: var(--navy-deep);
}

.button-outline {
  border: 1px solid rgba(255,255,255,.6);
  color: white;
}

.hero-proof {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 42px;
  padding-top: 24px;
  border-top: 1px solid rgba(255,255,255,.16);
  font-size: 11px;
  letter-spacing: 1.8px;
  font-weight: 900;
  color: var(--aqua);
}

.hero-art {
  min-height: 500px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.six-mark {
  width: min(430px,85vw);
  height: 470px;
  position: relative;
}

.six-top {
  width: 82px;
  height: 230px;
  background: linear-gradient(180deg,#ffd168,var(--gold-dark));
  position: absolute;
  top: 5px;
  left: 55%;
  transform: translateX(-50%) rotate(31deg);
  border-radius: 45px;
  box-shadow: 0 20px 60px rgba(244,185,66,.2);
}

.six-ring {
  width: 330px;
  height: 330px;
  border-radius: 50%;
  position: absolute;
  bottom: 10px;
  left: 50%;
  transform: translateX(-50%);
  background: conic-gradient(
    var(--gold) 0deg 60deg,
    var(--teal) 60deg 120deg,
    #167f9f 120deg 180deg,
    var(--navy) 180deg 240deg,
    var(--aqua) 240deg 300deg,
    #2d7190 300deg 360deg
  );
  box-shadow: 0 25px 90px rgba(0,0,0,.25);
}

.six-ring::before {
  content: "";
  position: absolute;
  inset: 58px;
  background: var(--navy-dark);
  border-radius: 50%;
}

.segment {
  display: none;
}

.compass {
  width: 150px;
  height: 150px;
  border: 2px solid rgba(255,255,255,.35);
  border-radius: 50%;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  color: white;
  z-index: 5;
}

.compass::before,
.compass::after {
  content: "";
  position: absolute;
  background: rgba(255,255,255,.22);
}

.compass::before {
  width: 1px;
  height: 100%;
  left: 50%;
}

.compass::after {
  height: 1px;
  width: 100%;
  top: 50%;
}

.compass span {
  position: absolute;
  font-size: 10px;
  font-weight: 900;
  color: var(--aqua);
}

.compass-n {
  top: 7px;
  left: 50%;
  transform: translateX(-50%);
}

.compass-s {
  bottom: 7px;
  left: 50%;
  transform: translateX(-50%);
}

.compass-e {
  right: 9px;
  top: 50%;
  transform: translateY(-50%);
}

.compass-w {
  left: 9px;
  top: 50%;
  transform: translateY(-50%);
}

.needle {
  color: var(--gold);
  font-size: 72px;
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%,-50%) rotate(28deg);
}

.compass-message {
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 2px;
  color: #d8e4ea;
  font-weight: 800;
  font-size: 12px;
  line-height: 1.7;
}

.section {
  padding: 100px 7%;
}

.journey {
  background: var(--cream);
}

.section-heading {
  max-width: 850px;
  margin: 0 auto 60px;
  text-align: center;
}

.section-heading h2 {
  color: var(--navy);
  font-size: clamp(34px,4vw,58px);
  line-height: 1.05;
  letter-spacing: -2px;
  margin: 0 0 20px;
}

.section-heading > p:last-child {
  color: var(--gray);
  font-size: 17px;
  line-height: 1.75;
}

.stage-grid {
  display: grid;
  grid-template-columns: repeat(6,1fr);
  max-width: 1400px;
  margin: 0 auto;
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  background: white;
}

.stage-card {
  min-height: 235px;
  padding: 30px 22px;
  border-right: 1px solid var(--border);
  position: relative;
}

.stage-card:last-child {
  border-right: 0;
}

.stage-card span {
  color: var(--gold);
  font-size: 28px;
  font-weight: 900;
}

.stage-card h3 {
  color: var(--navy);
  margin: 36px 0 12px;
  font-size: 17px;
  letter-spacing: 1px;
}

.stage-card p {
  color: var(--gray);
  line-height: 1.55;
  font-size: 14px;
}

.stage-card.featured {
  background: var(--navy);
}

.stage-card.featured h3,
.stage-card.featured p {
  color: white;
}

.stage-card.featured::after {
  content: "THE GLUE";
  position: absolute;
  top: 18px;
  right: 18px;
  color: var(--aqua);
  font-size: 8px;
  letter-spacing: 1.5px;
  font-weight: 900;
}

.difference {
  min-height: 720px;
  background: var(--navy);
  color: white;
  padding: 100px 8%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
}

.difference-copy {
  max-width: 650px;
}

.difference h2 {
  font-size: clamp(40px,5vw,70px);
  line-height: 1;
  margin: 0 0 30px;
  letter-spacing: -3px;
}

.large-copy {
  font-size: 22px;
  line-height: 1.5;
  color: #dce7ee;
}

.difference h3 {
  color: var(--gold);
  font-size: 30px;
  margin: 26px 0;
}

.difference-copy > p:not(.section-label):not(.large-copy) {
  line-height: 1.75;
  color: #dce7ee;
}

.difference-copy .gold-copy {
  color: var(--gold);
  font-weight: 800;
}

.ecosystem-visual {
  width: min(540px,90vw);
  height: 540px;
  position: relative;
  margin: 0 auto;
}

.ecosystem-ring {
  border-radius: 50%;
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
}

.ring-one {
  width: 390px;
  height: 390px;
  border: 1px solid rgba(102,194,198,.45);
}

.ring-two {
  width: 280px;
  height: 280px;
  border: 1px dashed rgba(244,185,66,.5);
}

.ecosystem-center,
.ecosystem-node {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  text-align: center;
  font-weight: 900;
}

.ecosystem-center {
  width: 180px;
  height: 180px;
  background: var(--gold);
  color: var(--navy);
  left: 50%;
  top: 50%;
  transform: translate(-50%,-50%);
  flex-direction: column;
}

.ecosystem-center strong {
  font-size: 22px;
}

.ecosystem-center span {
  font-size: 11px;
  margin-top: 5px;
}

.ecosystem-node {
  width: 120px;
  height: 120px;
  background: white;
  color: var(--navy);
  border: 5px solid var(--teal);
  font-size: 11px;
  letter-spacing: 1px;
}

.node-educator {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}

.node-employer {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

.node-community {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}

.node-mentor {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}

.audiences {
  background: var(--light);
}

.audience-grid {
  max-width: 1250px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 22px;
}

.audience-card {
  background: white;
  border: 1px solid var(--border);
  padding: 36px 30px;
  min-height: 260px;
  border-radius: 8px;
}

.card-line {
  width: 42px;
  height: 5px;
  background: var(--gold);
  margin-bottom: 28px;
}

.audience-card h3 {
  color: var(--navy);
  font-size: 23px;
  margin-bottom: 15px;
}

.audience-card p {
  color: var(--gray);
  line-height: 1.7;
  font-size: 14px;
}

.platform {
  padding: 100px 8%;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  gap: 70px;
  align-items: center;
}

.platform-heading h2 {
  color: var(--navy);
  font-size: clamp(34px,4vw,52px);
  line-height: 1.1;
  letter-spacing: -2px;
}

.platform-heading h2 span {
  color: var(--teal);
}

.platform-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.platform-items span {
  padding: 13px 17px;
  border: 1px solid var(--border);
  border-radius: 999px;
  color: var(--navy);
  font-size: 13px;
  font-weight: 800;
  background: white;
}

.outcome {
  background: var(--cream);
  text-align: center;
  padding: 110px 8%;
}

.outcome h2 {
  color: var(--navy);
  font-size: clamp(38px,5vw,68px);
  line-height: 1.1;
  letter-spacing: -3px;
  margin: 20px auto 28px;
}

.outcome h2 span {
  color: var(--gray);
}

.outcome h2 strong {
  color: var(--teal);
}

.outcome > p:last-child {
  max-width: 780px;
  margin: 0 auto;
  color: var(--gray);
  font-size: 18px;
  line-height: 1.75;
}

.final-cta {
  background: linear-gradient(120deg,var(--navy),var(--navy-dark));
  color: white;
  padding: 80px 8%;
  display: flex;
  justify-content: space-between;
  gap: 50px;
  align-items: center;
}

.final-cta h2 {
  font-size: clamp(36px,4vw,56px);
  margin: 0 0 15px;
}

.final-cta p:not(.section-label) {
  color: #dce7ee;
  font-size: 17px;
  line-height: 1.6;
  max-width: 700px;
}

.final-actions {
  display: flex;
  flex-direction: column;
  gap: 18px;
  align-items: center;
  min-width: 270px;
}

.text-link {
  color: var(--aqua);
  font-weight: 800;
  font-size: 13px;
}

footer {
  background: var(--navy-deep);
  color: #b8c9d3;
  padding: 38px 8%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
}

.footer-brand strong {
  color: white;
  font-size: 24px;
}

.footer-brand strong span {
  color: var(--gold);
  font-size: 31px;
}

.footer-brand p {
  margin: 5px 0 0;
  font-size: 9px;
  letter-spacing: 1.5px;
  color: var(--aqua);
}

@media (max-width: 1050px) {
  .main-nav {
    display: none;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-description {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions,
  .hero-proof,
  .hero-brand {
    justify-content: center;
  }

  .stage-grid {
    grid-template-columns: repeat(3,1fr);
  }

  .difference {
    grid-template-columns: 1fr;
  }

  .audience-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .platform {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 700px) {
  .site-header {
    padding: 0 5%;
  }

  .header-button {
    display: none;
  }

  .hero {
    padding: 70px 6%;
  }

  .stage-grid,
  .audience-grid {
    grid-template-columns: 1fr;
  }

  .ecosystem-visual {
    transform: scale(.72);
    margin: -60px auto;
  }

  .final-cta {
    flex-direction: column;
    text-align: center;
  }

  footer {
    flex-direction: column;
    gap: 18px;
    text-align: center;
  }
}

