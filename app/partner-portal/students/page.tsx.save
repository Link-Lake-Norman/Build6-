import { getStudents } from "@/lib/data/students";
import { matches } from "@/content/matches";

export default async function PartnerStudentsPage() {
  const students = await getStudents();

  return (
    <main>

      <section className="hero">
        <h1>
          Future Ready™ Partner Student Engagement
        </h1>

        <p>
          View student participation, readiness progress, and career alignment.
        </p>
      </section>


      <section className="journey-grid">

        {students.map((student) => (

          <article
            className="journey-card"
            key={student.id}
          >

            <h2>
              {student.name}
            </h2>

            <p>
              Grade: {student.grade}
            </p>

            <p>
              Readiness Score: {student.readinessScore}%
            </p>

            <h3>
              Career Interests
            </h3>

            {student.interests?.map((interest) => (
              <p key={interest}>
                {interest}
              </p>
            ))}

          </article>

        ))}

      </section>


      <section>

        <h2>
          Readiness Progress
        </h2>

        <div className="journey-grid">

          <article className="journey-card">

            <h3>
              Skills Development
            </h3>

            <p>
              Communication
            </p>

            <p>
              Leadership
            </p>

            <p>
              Professional Skills
            </p>

          </article>


          <article className="journey-card">

            <h3>
              Career Alignment
            </h3>

            <p>
              Future career pathways matched
            </p>

            <p>
              Employer connections available
            </p>

          </article>


          <article className="journey-card">

            <h3>
              Portfolio Growth
            </h3>

            <p>
              Experiences and achievements tracked
            </p>

          </article>

        </div>

      </section>


      <section>

        <h2>
          Career Matches
        </h2>

        <p>
          Active Matches: {matches.length}
        </p>

      </section>


    </main>
  );
}
