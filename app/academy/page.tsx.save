"use client";

import { useState, useEffect } from "react";
import { lessons } from "../../content/lessons";

export default function AcademyPage() {
  const [selectedLesson, setSelectedLesson] = useState(0);
  const [completedLessons, setCompletedLessons] = useState<number[]>([]);

  const lesson = lessons[selectedLesson];

  useEffect(() => {
    const saved = localStorage.getItem("future-ready-progress");

    if (saved) {
      setCompletedLessons(JSON.parse(saved));
    }
  }, []);

  function completeLesson() {
    if (!completedLessons.includes(selectedLesson)) {
      const updatedLessons = [
        ...completedLessons,
        selectedLesson,
      ];

      setCompletedLessons(updatedLessons);

      localStorage.setItem(
        "future-ready-progress",
        JSON.stringify(updatedLessons)
      );
    }
  }

  return (
    <main>

      <section className="hero">
        <h1>
          Future Ready™ Academy
        </h1>

        <p>
          <strong>
            {lesson.phase}
          </strong>
        </p>

        <h2>
          Week {lesson.week}: {lesson.title}
        </h2>

        <p>
          Discover Purpose. Build Skills. Launch Your Future.
        </p>
      </section>


      <section>
        <h2>
          Choose Your Lesson
        </h2>

        <div className="journey-grid">

          {lessons.map((item, index) => (

            <div
              className="journey-card"
              key={item.week}
              onClick={() => setSelectedLesson(index)}
              style={{
                cursor: "pointer",
              }}
            >

              <h3>
                Week {item.week}
              </h3>

              <p>
                {item.title}
              </p>

              <p>
                {item.phase}
              </p>

              <p>
                {
                  completedLessons.includes(index)
                  ? "✅ Completed"
                  : "⚪ Start Lesson"
                }
              </p>

            </div>

          ))}

        </div>

      </section>


      <section>
        <h2>
          Learning Objective
        </h2>

        <article className="journey-card">
          <p>
            {lesson.objective}
          </p>
        </article>
      </section>


      <section>
        <h2>
          Today's Activity
        </h2>

        <article className="journey-card">
          <p>
            {lesson.activity}
          </p>
        </article>
      </section>


      <section>
        <h2>
          Student Reflection
        </h2>

        <article className="journey-card">

          <p>
            {lesson.reflection}
          </p>

          <textarea
            rows={8}
            placeholder="Write your reflection here..."
          />

        </article>
      </section>


      <section>

        <article className="journey-card">

          <button
            onClick={completeLesson}
          >
            {
              completedLessons.includes(selectedLesson)
              ? "Lesson Completed ✅"
              : "Complete Lesson"
            }
          </button>

        </article>

      </section>


    </main>
  );
}
